{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hotkeys",
  "description": "Системные сочетания. Отдельно от прочих настольных прав, потому что список платформ у них разный: плагина нет на мобильных.",
  "platforms": [
    "macOS",
    "windows"
  ],
  "windows": [
    "main"
  ],
  "local": true,
  "remote": {
    "urls": [
      "https://verse.yeru.cc",
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "global-shortcut:default"
  ]
}

# Домен, на который смотрит A-запись сервера. Caddy получит сертификат сам.
DOMAIN=verse.yeru.cc

# TURN у Cloudflare (Realtime → TURN). Бесплатно до 1000 ГБ в месяц.
# Сервер сам выпускает короткоживущие учётки, в браузер постоянный ключ не попадает.
#
# Другого TURN нет и не поддерживается: постоянные логин и пароль всё равно
# уезжают в чужой браузер, где их прочитает кто угодно. Без этих ключей комната
# работает на одном STUN — соединятся не все.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

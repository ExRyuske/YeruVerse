{$DOMAIN} {
	encode zstd gzip

	# WebSocket проходит через reverse_proxy как есть, отдельных правил не нужно.
	reverse_proxy yeruverse:8080

	# Заголовки безопасности ставит сам сервер комнат — и ставит строже: там
	# `no-referrer`, потому что код комнаты живёт в адресной строке. Здесь они
	# только повторялись, причём Referrer-Policy повторялся ослабленным: правило
	# Caddy не дополняет чужой заголовок, а заменяет его своим.
	header {
		-Server
	}

	# Заголовки кэширования приходят от сервера комнат и должны дойти до
	# браузера и CDN как есть — своих здесь не добавляем.

	log {
		output stdout
		format console
	}
}
